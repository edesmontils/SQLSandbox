; Source des exercices (voir exercices.php et le README, section « Exercices »).
; À copier HORS du site, à côté de la racine web, sous le nom sqlsandbox.ini
; (~/sqlsandbox.ini chez OVH), avec des droits restreints (chmod 600) : le jeton
; donne accès aux solutions des exercices.
; Sans ce fichier, ou avec exos_source vide, SQLSandbox sert ses exercices locaux
; (bdd/exercices/).

; Instance QueryCraft dont les exercices sont repris : la démonstration
; (https://<hôte>/) ou le tenant d'un enseignant (https://<hôte>/<code>/).
; HTTPS obligatoire, sauf pour localhost.
exos_source = ""

; Jeton du catalogue de cette instance, créé côté QueryCraft avec :
;   tenant-sbs --set-catalogue-token demo      (ou le code à 6 chiffres du tenant)
; Le jeton de la démo sert aussi de jeton général : il ouvre chaque tenant dont l'enseignant
; a coché « Partage avec SQLSandbox » dans sa configuration, suivi à l'adresse
; /SQLSandbox/?123456 (exos_source désigne alors la racine de QueryCraft, https://<hôte>/).
exos_jeton = ""

; Secondes entre deux vérifications du catalogue (300 par défaut ; 0 = à chaque page)
exos_ttl = 300

; Espace disque des copies de bases des étudiants (facultatif, en Mo). Au-delà du total
; occupation_max_mo, ou s'il reste moins de espace_libre_min_mo sur le disque, aucune
; nouvelle copie n'est faite et les copies existantes ne grossissent plus.
; Valeurs par défaut prudentes pour un hébergement mutualisé : à relever sur un serveur
; dédié qui a de la place.
; occupation_max_mo = 1024
; espace_libre_min_mo = 200

; Durée de vie d'une session et des copies de bases d'un étudiant, depuis sa dernière
; activité (facultatif, en minutes ; à défaut, le seuil de config.xml : 180 minutes).
; duree_session_min = 180
