; Source des exercices (voir exercices.php et le README, section « Exercices »).
; À copier HORS du site, à côté de la racine web, sous le nom sqlsandbox.ini
; (~/sqlsandbox.ini chez OVH), avec des droits restreints (chmod 600) : le jeton
; donne accès aux solutions des exercices.
; Sans ce fichier, ou avec exos_source vide, SQLSandbox sert ses exercices locaux
; (bdd/exercices/).

; Instance QueryCraft dont les exercices sont repris : la démonstration
; (https://<hôte>/) ou le tenant d'un enseignant (https://<hôte>/<code>/).
; HTTPS obligatoire, sauf pour localhost.
exos_source = ""

; Jeton du catalogue de cette instance, créé côté QueryCraft avec :
;   tenant-sbs --set-catalogue-token demo      (ou le code à 6 chiffres du tenant)
exos_jeton = ""

; Secondes entre deux vérifications du catalogue (300 par défaut ; 0 = à chaque page)
exos_ttl = 300
